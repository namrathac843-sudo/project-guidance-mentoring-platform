# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.
# ------------------------------------------------------------------

# Flask session signing key (used for flash/cookie signing)
SECRET_KEY=change-me-to-a-long-random-string

# Where uploaded project files are stored on the server
UPLOAD_FOLDER=uploads

# Maximum size of ONE uploaded file, in megabytes
MAX_UPLOAD_MB=10

# ------------------------------------------------------------------
# College email / USN rules.
# Adjust these to match YOUR college. See README section "Adjusting
# the email and USN regular expressions".
# ------------------------------------------------------------------
COLLEGE_EMAIL_DOMAIN=gat.ac.in

# USN format used by the college, e.g. 1GA21CS001
# ^[0-9]{1}[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{3}$
USN_PATTERN=^[0-9]{1}[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{3}$

# If "true", students MUST use <USN>@<COLLEGE_EMAIL_DOMAIN>
REQUIRE_STUDENT_USN_EMAIL=true

# If "true", lecturers/alumni may use ANY email address.
# If "false", they must also use @<COLLEGE_EMAIL_DOMAIN>.
STRICT_EMAIL_FOR_ALL_ROLES=false

# Comma-separated list of admin emails allowed to self-register as admin.
# Leave EMPTY to forbid all public admin registration (recommended).
ALLOWED_ADMIN_EMAILS=

# Set to "development" for local work
FLASK_ENV=development